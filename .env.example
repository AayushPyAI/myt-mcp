# MYT public API key (GUID) — from the client / MYT support
MYT_API_KEY=

# Random secret that becomes part of the connector URL: https://<host>/mcp/<MCP_SECRET>
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET=

# Comma-separated Host headers accepted (add your deployed domain, e.g. myt-mcp.up.railway.app)
ALLOWED_HOSTS=127.0.0.1:*,localhost:*
HOST=127.0.0.1
PORT=8000

# Optional: limit every tool to these MYT trip ids (comma-separated). Empty = no limit.
ALLOWED_TRIP_IDS=

# Ofran car prices. Ofran blocks Indian IPs (403). Outside India nothing is needed.
# Optional proxy for direct requests, e.g. http://user:pass@host:port
OFRAN_PROXY=
# Chrome started with --remote-debugging-port, used by integrations that need a real browser
BROWSER_CDP_URL=
# Local testing from India only: send Ofran requests through that browser (VPN extension on)
OFRAN_USE_BROWSER=false

# Scraping safety for sites without an official API (Ofran)
OFRAN_ENABLED=true
SCRAPE_MIN_INTERVAL_SECONDS=5
SCRAPE_MAX_PER_HOUR=60
SCRAPE_CACHE_MINUTES=10

# Trenitalia train prices (lefrecce.it JSON service)
TRENITALIA_ENABLED=true

# Viator activities (read in the automation browser: BROWSER_CDP_URL)
VIATOR_ENABLED=true

# SATA flights (azoresairlines.pt, read in the automation browser: BROWSER_CDP_URL)
SATA_ENABLED=true

# Aspire lounges (through the automation browser when BROWSER_CDP_URL is set)
ASPIRE_ENABLED=true
